# ─────────────────────────────────────────────────────────────────
# OpMan-GPT – Umgebungsvariablen
# Kopieren nach ".env" und Werte anpassen.
#
# NIEMALS die echte .env in Git einchecken!
# ─────────────────────────────────────────────────────────────────

# Pflicht: sicherer Zufalls-Key für Flask-Sessions
# Generieren mit:  openssl rand -hex 32
SECRET_KEY=bitte-aendern-openssl-rand-hex-32

# Host-Port auf dem der Container erreichbar ist (Standardwert: 8000)
HOST_PORT=8000

# Anzahl gunicorn-Worker (Faustregel: 2 × CPU-Kerne + 1)
GUNICORN_WORKERS=2

# ─── Öffentliche Base-URL ────────────────────────────────────────
# Die URL unter der die App von außen erreichbar ist.
# Wird für QR-Codes, EVT-Links und alle generierten URLs verwendet.
# Leer lassen = automatische Erkennung der LAN-IP.
#
# Beispiele:
#   BASE_URL=https://uebung.feuerwehr-musterstadt.de
#   BASE_URL=http://192.168.1.100:8000
#   BASE_URL=https://opman.example.com
BASE_URL=

# ─── GitHub-Zugang (privates Repo) ─────────────────────────────────
# Damit der Container Updates aus dem privaten Repo ziehen kann:
#   1. GITHUB_USER = dein GitHub-Benutzername
#   2. GITHUB_TOKEN = Personal Access Token (classic) mit "repo"-Scope
# Token erstellen unter: https://github.com/settings/tokens
# ─── what3words API-Key ────────────────────────────────────────
# Für die Auflösung von w3w-Adressen zu GPS-Koordinaten.
# Ohne Key funktioniert die w3w-Auflösung nur aus dem lokalen Cache.
W3W_API_KEY=

# ─── GitHub-Zugang (privates Repo) ─────────────────────────────────
GITHUB_USER=
GITHUB_TOKEN=
